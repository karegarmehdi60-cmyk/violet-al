{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "violet-al",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
